GET http://localhost:5187/games

# you need the 3 ### signs to show that this is a new request
###
GET http://localhost:5187/games/1


# Before you send the json, u gotta specifiy the type which is what we do
# at Line 11. Also, You gotta leave an empty space right after it 
# to separate it from the json body
###
POST http://localhost:5187/games
Content-Type: application/json

{
    "name": "Street Fighter If",
    "genreId": 1,
    "price": 9.99,
    "releaseDate": "1991-02-01"
}

###
PUT http://localhost:5187/games/1
Content-Type: application/json

{
    "name": "Street Fighter II Turbo",
    "genre": "Fighting",
    "price": 9.99,
    "releaseDate": "1992-07-15"
}

###
DELETE http://localhost:5187/games/1